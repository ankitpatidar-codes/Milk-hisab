# Milk Hisab - Environment Configuration Template
# Copy this file to .env and configure values

# Database URL
# For Local Development (SQLite):
DATABASE_URL=sqlite:///milk_hisab.db

# For Production (PostgreSQL on Render or Railway):
# DATABASE_URL=postgresql://username:password@hostname:5432/milk_hisab

# Secret key for session encryption (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace-with-a-secure-random-secret-key

# Flask environment: 'development' or 'production'
FLASK_ENV=development

# Optional Port (Render/Railway inject this automatically)
PORT=5000
